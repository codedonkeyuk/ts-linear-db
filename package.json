{
  "name": "ts-linear-db",
  "version": "0.0.1",
  "description": "Database project that implements updates following the linear delta pattern.",
  "homepage": "https://github.com/codedonkeyuk/ts-linear-db#readme",
  "bugs": {
    "url": "https://github.com/codedonkeyuk/ts-linear-db/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codedonkeyuk/ts-linear-db.git"
  },
  "license": "MIT",
  "author": "Leigh",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "clean": "npx prettier . --write && npx oxlint --type-aware --fix",
    "validate": "prettier . --check && npx oxlint --type-aware && tsc --noEmit && npx cspell README.md",
    "prebuild": "npx prettier . --check && npx oxlint --type-aware && tsc --noEmit",
    "db": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test \"**/*.test.ts\"",
    "coverage": "node --experimental-strip-types --experimental-test-module-mocks --test --experimental-test-coverage \"**/*.test.ts\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "3.9.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "knex": "^3.3.0"
  }
}
